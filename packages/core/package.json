{
  "name": "@pathseekr/core",
  "version": "0.1.0",
  "private": true,
  "description": "Core engine for Pathseekr — parsing, indexing, retrieval",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "postbuild": "cp -r src/storage/migrations dist/storage",
    "dev": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pathseekr/shared": "*",
    "better-sqlite3": "^9.4.0",
    "fast-glob": "^3.3.0",
    "inversify": "^6.0.0",
    "tree-sitter": "^0.21.0",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0",
    "ollama": "^0.5.0",
    "reflect-metadata": "^0.2.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.4.0"
  }
}