{
  "name": "@pathseekr/core",
  "version": "0.1.0-beta.1",
  "description": "Core indexing and search engine for Pathseekr",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src/storage/migrations", "README.md"],
  "license": "MIT",
  "engines": { "node": ">=20.1.0" },
  "repository": {
    "type": "git",
    "url": "https://github.com/yatin166/pathseekr"
  },
  "keywords": ["pathseekr", "code-search", "indexing", "bm25", "graph-search"],
  "scripts": {
    "build": "tsc && npm run copy-migrations",
    "copy-migrations": "cp -r src/storage/migrations dist/storage/migrations",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pathseekr/shared": "0.1.0-beta.1",
    "better-sqlite3": "^9.0.0",
    "inversify": "^6.0.0",
    "reflect-metadata": "^0.2.0",
    "tree-sitter": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-java": "^0.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}