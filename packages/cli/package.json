{
  "name": "@pathseekr/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for Pathseekr — index and search your codebase",
  "license": "MIT",
  "bin": {
    "pathseekr": "./dist/index.js",
    "seek": "./dist/index.js"
  },
  "scripts": {
