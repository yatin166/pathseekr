{
  "name": "@pathseekr/mcp",
  "version": "0.1.0-beta.1",
  "description": "MCP server for Pathseekr — exposes code search to AI assistants",
  "main": "dist/index.js",
  "files": ["dist", "README.md"],
  "license": "MIT",
  "engines": { "node": ">=18.0.0" },
  "repository": {
    "type": "git",
    "url": "https://github.com/yatin166/pathseekr"
  },
  "keywords": ["pathseekr", "mcp", "code-search", "ai", "claude"],
